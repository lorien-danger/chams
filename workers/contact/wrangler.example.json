{
  "name": "chams-contact",
  "main": "index.mjs",
  "compatibility_date": "2026-09-14",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "chams.com.au/*", "zone_name": "chams.com.au" },
    { "pattern": "www.chams.com.au/api/contact*", "zone_name": "chams.com.au" }
  ],
  "ratelimits": [
    { "name": "CONTACT_LIMITER", "namespace_id": "2026091401", "simple": { "limit": 5, "period": 60 } }
  ],
  "send_email": [
    { "name": "EMAIL", "destination_address": "REPLACE_IN_PRIVATE_CONFIG_ONLY", "allowed_sender_addresses": ["office@chams.com.au"] }
  ],
  "observability": { "enabled": false }
}
