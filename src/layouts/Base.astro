---
import '../colors_and_type.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  activeRoute?: string;
}

const SITE_URL = 'https://www.chams.com.au';
const { title, description, image = '/assets/og/default.png', activeRoute = 'home' } = Astro.props;
const absoluteImage = image.startsWith('http') ? image : `${SITE_URL}${image}`;
const canonicalURL = new URL(Astro.url.pathname, SITE_URL).href;
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png?v=20260508" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=20260508" />
    <link rel="shortcut icon" href="/favicon.ico?v=20260508" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=20260508" />
    <meta name="apple-mobile-web-app-title" content="Cham's" />
    <link rel="manifest" href="/site.webmanifest?v=20260508" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="api-catalog" href="/.well-known/api-catalog" type="application/linkset+json" />
    <link rel="service-desc" href="/api/openapi.json" type="application/openapi+json" />
    <link rel="service-doc" href="/docs/api/" />
    <link rel="describedby" href="/auth.md" type="text/markdown" />
    <meta name="description" content={description} />
    <meta name="geo.region" content="AU-NSW" />
    <meta name="geo.placename" content="Lismore" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Cham's Small Meats & Preservatives" />
    <meta property="og:image" content={absoluteImage} />
    <meta property="og:locale" content="en_AU" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImage} />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "@id": "https://www.chams.com.au/#business",
      "name": "Cham's Small Meats & Preservatives",
      "url": "https://www.chams.com.au",
      "logo": "https://www.chams.com.au/assets/logos/chams-main-blue.svg",
      "image": "https://www.chams.com.au/assets/og/default.png",
      "description": "Family-owned smallgoods manufacturer based in Lismore, Northern NSW. Traditional cured meats and preservatives since 1987.",
      "foundingDate": "1987",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "12 Industrial Drive",
        "addressLocality": "Lismore",
        "addressRegion": "NSW",
        "postalCode": "2480",
        "addressCountry": "AU"
      },
      "telephone": "+61266214488",
      "email": "office@chams.com.au",
      "openingHours": "Mo-Fr 07:00-16:00",
      "priceRange": "$$",
      "sameAs": []
    })} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@600;700;800;900&family=Barlow+Condensed:wght@500;600;700&family=Source+Sans+3:wght@400;500;600;700&family=Source+Serif+4:ital,wght@1,400&family=Caveat+Brush&family=JetBrains+Mono:wght@400;500&display=swap" />
    <style>
      *, *::before, *::after { box-sizing: border-box; }
      body { margin: 0; }
    </style>
    <slot name="head" />
  </head>
  <body>
    <Header activeRoute={activeRoute} />
    <slot />
    <Footer />
    <script>
      (() => {
        const modelContext = navigator.modelContext;
        if (!modelContext) return;

        const tools = [
          {
            name: 'search_products',
            description: "Search Cham's public product range by name, category, ingredient, or format.",
            inputSchema: {
              type: 'object',
              properties: {
                query: {
                  type: 'string',
                  description: 'Search text to match against public product information.'
                }
              },
              required: ['query']
            },
            execute: async ({ query }) => {
              const response = await fetch('/api/products.json');
              const { products } = await response.json();
              const needle = String(query || '').toLowerCase();
              return products.filter((product) => JSON.stringify(product).toLowerCase().includes(needle));
            }
          },
          {
            name: 'get_wholesale_contact',
            description: "Return Cham's public wholesale contact details and enquiry page.",
            inputSchema: {
              type: 'object',
              properties: {}
            },
            execute: async () => ({
              name: "Cham's Small Meats & Preservatives",
              telephone: '+61266214488',
              email: 'office@chams.com.au',
              enquiryUrl: 'https://www.chams.com.au/contact/'
            })
          }
        ];

        const controller = new AbortController();
        if (typeof modelContext.registerTool === 'function') {
          tools.forEach((tool) => modelContext.registerTool(tool, { signal: controller.signal }));
        } else if (typeof modelContext.provideContext === 'function') {
          modelContext.provideContext({ tools }, { signal: controller.signal });
        }
        window.addEventListener('pagehide', () => controller.abort(), { once: true });
      })();
    </script>
  </body>
</html>
