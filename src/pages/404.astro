---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Container from '../components/Container.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
---
<Base
  title="Page Not Found - Cham's Small Meats & Preservatives"
  description="The page you requested could not be found."
  activeRoute=""
>
  <main>
    <Section bg="cream" style="padding-top: 88px; padding-bottom: 112px;">
      <Container>
        <div class="not-found">
          <Eyebrow>404</Eyebrow>
          <h1>Page Not Found</h1>
          <p>
            This address does not match a current Cham's page. The product range, wholesale details, and contact information are still available from the main site.
          </p>
          <div class="not-found-actions">
            <Button kind="primary" href="/">Home <Icon name="arrowRight" size={14} /></Button>
            <Button kind="outline" href="/products/">Products</Button>
            <Button kind="outline" href="/contact/">Contact</Button>
          </div>
        </div>
      </Container>
    </Section>
  </main>
</Base>

<style>
  .not-found {
    max-width: 720px;
  }
  .not-found h1 {
    font-family: var(--font-display);
    font-size: 88px;
    line-height: .95;
    text-transform: uppercase;
    color: var(--chams-blue-ink);
    margin: 18px 0 22px;
  }
  .not-found p {
    max-width: 560px;
    font-size: 19px;
    line-height: 1.5;
    color: var(--chams-stone);
    margin: 0 0 30px;
  }
  .not-found-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }
  @media (max-width: 768px) {
    .not-found h1 {
      font-size: 56px;
    }
  }
</style>
