---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Container from '../components/Container.astro';
import Eyebrow from '../components/Eyebrow.astro';
import SectionHead from '../components/SectionHead.astro';
import Icon from '../components/Icon.astro';
import ImageBlock from '../components/ImageBlock.astro';
---
<Base
  title="Community & Environment — Cham's Small Meats & Preservatives"
  description="Cham's is committed to the Northern Rivers community. Proud supporter of Dam Kings Beach and responsible environmental management."
  image="/assets/photos/dam_kings_beach_community.png"
  activeRoute="community"
>
  <main>
    <Section bg="cream" style="padding-top: 56px; padding-bottom: 32px;">
      <Container>
        <div class="community-intro">
          <Eyebrow>Community &amp; Environment</Eyebrow>
          <h1 class="community-title">Committed to the Place We Operate.</h1>
          <p class="community-lede">
            Cham's is a Northern NSW business, and the place we operate matters to us. We are committed to responsible environmental management at our Lismore facility and to supporting community partners who do meaningful work in our region.
          </p>
        </div>
      </Container>
    </Section>

    <Section bg="bone" style="padding-top: 64px; padding-bottom: 80px;">
      <Container>
        <div class="partner-grid">
          <div class="partner-card">
            <img src="/assets/logos/dam-kings-beach.svg" alt="Dam Kings Beach" style="height: 64px; margin-bottom: 16px;" />
            <Eyebrow>Community Partner</Eyebrow>
            <h2 class="partner-title">Dam Kings Beach</h2>
            <p class="partner-text">
              Cham's is proud to support the Dam Kings Beach initiative, a community-led project working to maintain and improve public-access waterways in our region. We provide annual financial support and donate to their seasonal community events.
            </p>
            <p class="partner-text">
              Our partnership reflects our commitment to the Northern Rivers community and to the long-term stewardship of the natural assets that make this part of Australia what it is.
            </p>
            <a href="https://damkingsbeach.org" target="_blank" rel="noopener noreferrer" class="partner-link">
              damkingsbeach.org <Icon name="arrowRight" size={12} />
            </a>
          </div>
          <div class="partner-sidebar">
            <ImageBlock label="dam kings beach · community day" ratio="16/9" tone="archival" src="/assets/photos/dam_kings_beach_community.png" objectPosition="center 40%" />
            <div class="partner-quote-card">
              <Eyebrow>From the Founder</Eyebrow>
              <p class="partner-quote">
                "We been here forty year. The river, the beach, all this — it's our community. You support the community, the community support you. That's how it works."
              </p>
              <div class="partner-attribution">— Cham Bellanova</div>
            </div>
            <div class="partner-sponsor-card">
              <img src="/assets/logos/dam-kings-beach.svg" alt="Dam Kings Beach" style="height: 56px; flex-shrink: 0;" />
              <div class="partner-sponsor-text">
                Cham's is a founding sponsor of the Dam Kings Beach initiative. Supporting clean waterways in the Northern Rivers since 2019.
              </div>
            </div>
          </div>
        </div>
      </Container>
    </Section>

    <Section bg="cream">
      <Container>
        <SectionHead eyebrow="Operations" title="Environmental Management" />
        <div class="env-grid">
          {[
            { t: 'Water', d: 'Closed-loop water recycling on all sanitation lines, installed 2019. ~62% reduction in mains water draw vs 2018 baseline.' },
            { t: 'Waste', d: 'Trim and bone by-product diverted to local agricultural use. Plastic and cardboard packaging waste sorted for recycling on-site.' },
            { t: 'Energy', d: 'Rooftop solar (148 kW) installed 2022. Refrigeration retro-fitted to natural-refrigerant condensers.' },
          ].map(v => (
            <div class="env-item">
              <h3 class="env-title">{v.t}</h3>
              <p class="env-desc">{v.d}</p>
            </div>
          ))}
        </div>
      </Container>
    </Section>
  </main>
</Base>

<style>
  .community-intro { max-width: 820px; }
  .community-title {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 80px;
    line-height: 0.96;
    text-transform: uppercase;
    color: var(--chams-blue-ink);
    margin: 16px 0 20px;
    letter-spacing: -0.005em;
  }
  .community-lede {
    font-size: 19px;
    line-height: 1.5;
    color: var(--chams-stone);
  }
  .partner-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: stretch;
  }
  .partner-card {
    background: var(--chams-cream);
    border: 3px solid var(--chams-blue);
    border-radius: 4px;
    padding: 36px;
  }
  .partner-title {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 44px;
    text-transform: uppercase;
    color: var(--chams-blue-ink);
    margin: 10px 0 16px;
    line-height: 1;
  }
  .partner-text {
    font-size: 16px;
    line-height: 1.55;
    color: var(--chams-stone);
  }
  .partner-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-subhead);
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--chams-red);
    text-decoration: none;
    border-bottom: 2px solid var(--chams-red);
    padding-bottom: 2px;
    margin-top: 8px;
  }
  .partner-sidebar {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .partner-quote-card {
    background: var(--chams-cream);
    border: 1px solid var(--chams-tan);
    border-radius: 4px;
    padding: 28px;
  }
  .partner-quote {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 22px;
    line-height: 1.5;
    color: var(--chams-blue-ink);
    margin: 14px 0 0;
  }
  .partner-attribution {
    font-family: var(--font-subhead);
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--chams-stone);
    margin-top: 16px;
  }
  .partner-sponsor-card {
    background: var(--chams-cream);
    border: 1px solid var(--chams-tan);
    border-radius: 4px;
    padding: 28px;
    display: flex;
    align-items: center;
    gap: 24px;
  }
  .partner-sponsor-text {
    font-size: 14px;
    line-height: 1.55;
    color: var(--chams-stone);
  }
  .env-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
    margin-top: 36px;
  }
  .env-item {
    border-top: 2px solid var(--chams-blue);
    padding-top: 14px;
  }
  .env-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 26px;
    text-transform: uppercase;
    color: var(--chams-blue-ink);
    margin: 0;
  }
  .env-desc {
    font-size: 14px;
    line-height: 1.55;
    color: var(--chams-stone);
    margin-top: 8px;
    margin-bottom: 0;
  }

  @media (max-width: 768px) {
    .community-title { font-size: 44px; }
    .partner-grid { grid-template-columns: 1fr; gap: 32px; }
    .partner-card { padding: 20px; }
    .env-grid { grid-template-columns: 1fr; }
  }
</style>
