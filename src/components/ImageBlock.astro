---
interface Props {
  label?: string;
  ratio?: string;
  tone?: string;
  src?: string;
  objectPosition?: string;
  objectFit?: string;
  style?: string;
}
const { label, ratio = '4 / 3', tone = 'product', src, objectPosition = 'center center', objectFit = 'cover', style } = Astro.props;

const tones: Record<string, string> = {
  curing:   'linear-gradient(135deg, #3a2418 0%, #5a2f1d 100%)',
  factory:  'linear-gradient(135deg, #2b3540 0%, #475968 100%)',
  product:  'linear-gradient(135deg, #4a2a20 0%, #6b3a28 100%)',
  portrait: 'linear-gradient(135deg, #2a2620 0%, #4a4036 100%)',
  cream:    'linear-gradient(135deg, #E7D9B4 0%, #D9C99B 100%)',
  archival: 'linear-gradient(135deg, #3a342c 0%, #5e574b 100%)',
};
const bg = tones[tone] || tones.product;
const srcBase = src ? src.replace(/\.(png|jpe?g)$/i, '') : null;
const srcExt = src ? src.match(/\.(png|jpe?g)$/i)?.[0] : null;
---
<div class="image-block" style={`background: ${bg}; aspect-ratio: ${ratio};${style ? ' ' + style : ''}`}>
  {src ? (
    <picture>
      {srcBase && <source srcset={`${srcBase}.avif`} type="image/avif" />}
      {srcBase && <source srcset={`${srcBase}.webp`} type="image/webp" />}
      <img src={src} alt={label || ''} style={`object-fit: ${objectFit}; object-position: ${objectPosition};`} loading="lazy" />
    </picture>
  ) : (
    <div class="placeholder">[ photo &middot; {label} ]</div>
  )}
</div>

<style>
  .image-block {
    border-radius: 4px;
    position: relative;
    overflow: hidden;
  }
  .image-block img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  .placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    justify-content: flex-start;
    padding: 14px;
    color: rgba(255,255,255,.5);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
  }
</style>
