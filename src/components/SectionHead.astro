---
import Eyebrow from './Eyebrow.astro';

interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
  align?: 'left' | 'center';
  color?: 'cream' | 'default';
}
const { eyebrow, title, lede, align = 'left', color = 'default' } = Astro.props;
const isCream = color === 'cream';
---
<div class:list={['section-head', `align-${align}`]}>
  <div class:list={['head-rule', { cream: isCream }]}>
    {eyebrow && <Eyebrow color={isCream ? 'rgba(242,231,203,.85)' : undefined}>{eyebrow}</Eyebrow>}
  </div>
  <h2 class:list={['head-title', { cream: isCream }]}>{title}</h2>
  {lede && <p class:list={['head-lede', { cream: isCream }]}>{lede}</p>}
</div>

<style>
  .section-head.align-center {
    text-align: center;
    max-width: 760px;
    margin: 0 auto;
  }
  .head-rule {
    border-top: 2px solid var(--chams-blue);
    padding-top: 14px;
    display: inline-block;
    min-width: 240px;
  }
  .head-rule.cream {
    border-color: var(--chams-cream);
  }
  .head-title {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 56px;
    line-height: 0.98;
    letter-spacing: -0.005em;
    text-transform: uppercase;
    color: var(--chams-blue-ink);
    margin: 10px 0 16px;
  }
  .head-title.cream {
    color: var(--chams-cream);
  }
  .head-lede {
    font-size: 19px;
    line-height: 1.45;
    color: var(--chams-stone);
    max-width: 640px;
  }
  .head-lede.cream {
    color: rgba(242,231,203,.85);
  }
  .align-center .head-lede {
    margin-left: auto;
    margin-right: auto;
  }
  @media (max-width: 768px) {
    .head-rule {
      min-width: 0;
    }
    .head-title {
      font-size: 36px;
    }
  }
</style>
